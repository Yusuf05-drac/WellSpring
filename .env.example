# ==============================================================================
# WellSpring – Firebase Authentication & Web Configuration Template
# ==============================================================================
# Instructions:
# 1. Open Firebase Console: https://console.firebase.google.com/
# 2. Open project: wellspring-05
# 3. Under Authentication -> Sign-in method:
#    - Enable "Email/Password"
#    - Enable "Google" (select your support email and Save)
# 4. Under Authentication -> Settings -> Authorized domains:
#    - Verify "localhost" is listed
# 5. Under Project Settings -> General -> Your apps -> Web app (</>):
#    - Copy your config values into your `.env` file below:
# ==============================================================================

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=wellspring-05.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wellspring-05
VITE_FIREBASE_STORAGE_BUCKET=wellspring-05.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
